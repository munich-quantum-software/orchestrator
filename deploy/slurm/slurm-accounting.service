[Unit]
Description=Initialize Slurm accounting associations
Requires=slurmdbd.service
PartOf=slurmdbd.service
After=slurmdbd.service

[Service]
Type=oneshot
Environment=PATH=/opt/slurm/bin:/opt/slurm/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/mqt-slurm-accounting
RemainAfterExit=yes
Restart=on-failure
RestartSec=2
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
