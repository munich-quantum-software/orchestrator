{
  "author": {
    "name": "Munich Quantum Software Company GmbH",
    "years": [2026]
  },
  "force_author": true,
  "force_license": true,
  "title": false,
  "include": ["**/*"],
  "style_override_for_suffix": {
    ".yaml": "POUND_STYLE",
    ".toml": "POUND_STYLE",
    ".conf": "POUND_STYLE",
    ".service": "POUND_STYLE",
    ".socket": "POUND_STYLE",
    ".lua": "DASH_STYLE",
    ".js": "C_STYLE",
    ".css": "C_STYLE"
  },
  "exclude": [
    "^\\.[^/]+",
    "/\\.[^/]+",
    "demos/qc-afqmc/upstream/",
    "brand/",
    ".*\\.md$",
    ".*\\.json$",
    ".*\\.svg$",
    ".*\\.lock$",
    "(^|/)LICENSE$"
  ],
  "custom_license": "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception\n\nLicensed under the Apache License v2.0 with LLVM Exceptions.\nSee https://llvm.org/LICENSE.txt for license information."
